{
    "name": "token-walk-animation",
    "version": "14.0.0-beta.11",
    "description": "System-agnostic token movement, mouse/WASD animation, auto-facing flip, camera follow, and visual-novel HUD controls for Foundry VTT v14.367+",
    "main": "index.js",
    "scripts": {
        "lint": "eslint . --ext .ts,.js",
        "type-check": "tsc --noEmit",
        "ci": "vite build && node scripts/inject-id.js",
        "update-readme": "node scripts/update-readme.js",
        "link:dev": "node scripts/link-dev.js",
        "dev": "pnpm link:dev && vite dev",
        "link:dist": "node scripts/link-dist.js",
        "build": "pnpm link:dist && npm run type-check && vite build && node scripts/inject-id.js",
        "build:rc": "npm run type-check && vite build && node scripts/inject-id.js",
        "postbuild:rc": "dotenv -e .env -- sh -c 'rsync -avz --delete dist/ \"$DEPLOY_HOST_ALIAS:$DEPLOY_PATH\"'"
    },
    "keywords": [],
    "author": "",
    "license": "MIT",
    "packageManager": "pnpm@10.6.1",
    "devDependencies": {
        "autoprefixer": "^10.4.21",
        "dotenv-cli": "^8.0.0",
        "eslint": "^9.25.0",
        "fast-glob": "^3.3.3",
        "fvtt-types": "github:League-of-Foundry-Developers/foundry-vtt-types#main",
        "postcss": "^8.5.3",
        "tsx": "^4.19.4",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.30.1",
        "vite": "^6.3.5",
        "vite-plugin-static-copy": "^2.3.1",
        "vitest": "^3.1.2"
    },
    "pnpm": {
        "ignoredBuiltDependencies": [
            "esbuild"
        ],
        "onlyBuiltDependencies": [
            "esbuild"
        ]
    },
    "dependencies": {
        "gsap": "^3.12.7",
        "symlink-dir": "^6.0.5"
    }
}
